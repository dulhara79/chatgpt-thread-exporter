{
  "manifest_version": 3,
  "name": "AI Thread Exporter",
  "short_name": "AI Export",
  "version": "0.6.3",
  "description": "Export any ChatGPT or Claude conversation \u2014 or a single Q&A \u2014 to professional PDF, Word (.docx), or Markdown documents.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "downloads",
    "offscreen",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.oaistatic.com/*",
    "https://claude.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export this conversation"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "math.js",
        "src/platforms/adapter.js",
        "src/platforms/chatgpt.js",
        "src/platforms/claude.js",
        "src/platforms/registry.js",
        "src/ir/parse.js",
        "src/ir/extract.js",
        "src/ir/markdown.js",
        "src/ir/pdf.js",
        "src/ir/docx.js",
        "exporter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
